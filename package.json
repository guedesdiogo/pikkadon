{
  "name": "@guedesdiogo/pikkadon",
  "version": "0.0.0",
  "description": "One-time expiring forms for values that never pass through a model: a kit each host embeds.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guedesdiogo/pikkadon.git"
  },
  "private": true,
  "type": "module",
  "sideEffects": false,
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run --coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@vitest/coverage-istanbul": "^4.1.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  }
}
